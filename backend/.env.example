# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
# Local dev example: postgresql://roomstage:yourpassword@localhost:5432/roomstage_dev
# Railway/Render will give you this string directly when you provision a database
DATABASE_URL=postgresql://user:password@localhost:5432/roomstage_dev

# JWT
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Cloudinary (wire up in Week 3 — see README "Photo uploads" section)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja (wire up when adding deposit payments)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
